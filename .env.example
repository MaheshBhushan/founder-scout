# Required for the Discord bot
DISCORD_TOKEN=
# Channel that receives automatic scouting posts (right-click channel > Copy Channel ID)
DISCORD_CHANNEL_ID=
# Optional: register slash commands to one server instantly instead of globally
DISCORD_GUILD_ID=

# Firecrawl scrapes and extracts pages. Required.
FIRECRAWL_API_KEY=
# Exa improves discovery (semantic search over founder pages). Optional but recommended.
EXA_API_KEY=

# Pages scraped per run. Each page costs about 5 Firecrawl credits with JSON extraction.
MAX_PAGES_PER_RUN=8
# Minutes between automatic runs. 0 disables the loop.
AUTO_INTERVAL_MINUTES=60
# Scrape the company website when a founder page lists no email (1 extra credit each).
FOLLOW_COMPANY_SITE=true
DB_PATH=founders.db

# Outreach: emails per 24 h from founder-scout (the tracker caps all outreach at 15).
OUTREACH_DAILY_LIMIT=30
# File to read ANTHROPIC_API_KEY from when it is not in the environment.
ANTHROPIC_ENV_FILE=~/.hermes/.env
