# Required for the Discord bot
DISCORD_TOKEN=
# Channel that receives automatic scouting posts (right-click channel > Copy Channel ID)
DISCORD_CHANNEL_ID=
# Optional: register slash commands to one server instantly instead of globally
DISCORD_GUILD_ID=
# Slash commands only run in DISCORD_CHANNEL_ID. Optional: comma-separated Discord user IDs allowed to run them.
DISCORD_ALLOWED_USER_IDS=

# Search uses the open-source ddgs library by default. Set this to use a self-hosted SearXNG (JSON format enabled).
SEARXNG_URL=
# Model that claude -p uses to extract profiles from scraped pages.
EXTRACT_MODEL=claude-haiku-5-5

# Pages scraped and extracted per run. Each page uses one claude -p call.
MAX_PAGES_PER_RUN=8
# Minutes between automatic runs. 0 disables the loop.
AUTO_INTERVAL_MINUTES=60
# Scrape the company website when a founder page lists no email (no Claude call).
FOLLOW_COMPANY_SITE=true
DB_PATH=founders.db

# Outreach: emails per 24 h from founder-scout (the tracker caps all outreach at 15).
OUTREACH_DAILY_LIMIT=30
# Claude Code drafts the outreach emails; set CLAUDE_BIN if claude is not on PATH.
CLAUDE_EFFORT=medium

# Explicit researched application fallback only (contact-resolve); never used by discovery.
# Trusted Reacher base URL; POST /v0/check_email is appended by the resolver.
# Also configurable via ~/.config/tailor-tracker/reacher-url and reacher-key.
REACHER_URL=
# Optional service secret sent as x-reacher-secret; keep this private.
REACHER_API_KEY=
# Queueing uses the existing tracker, not Gmail. Config files url/token also work.
TAILOR_TRACKER_URL=
TAILOR_TRACKER_TOKEN=
